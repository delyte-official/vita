func test(): string {
    val r: int = 2;
    val width = 3;
    return "this is a complex {r} string with {r + width + 2 / 3} products";
}

func main(): int {
    val yo: int = 2;
    val ret = test();
    if (2+4) {
        val yo = 2;
        return 3;
    } elif (5) {
        test();
        return 2;
    } else {
        return ret;
    }
}