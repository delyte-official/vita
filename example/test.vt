func test(): int {
    val r: int = (10 / 5);
    val width = 3;
    return r * (width + 6);
}

primitive class meters {
    val value: int;

    constructor(<m: int>m) {
        value = m;
    }

    func to_int(): int {
        return value;
    }
}

func main(): int {
    val yo: int = 2;
    val ret = test();
    if (2+4) {
        val yo = 2;
        return ret;
    } elif (5) {
        test();
        return 2;
    } else {
        return 56;
    }
}